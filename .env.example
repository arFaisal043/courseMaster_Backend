# Local backend configuration. Never commit real credentials.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/coursemaster_test
JWT_SECRET=

# Optional: enables admin registration through POST /api/auth/register.
# Leave empty to disable public admin registration.
ADMIN_REGISTRATION_KEY=

# Optional welcome-email configuration.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
FRONTEND_URL=http://localhost:5173

# Seeding permanently replaces data in the selected database.
# Use only with a disposable database ending in _test or _demo.
SEED_ALLOW_RESET=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_STUDENT_EMAIL=student@coursemaster.com
SEED_STUDENT_PASSWORD=
